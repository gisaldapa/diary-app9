    {
      "name": "CREATE - Diary Baru",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/diaries",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "diaries"
          ]
        },
        "description": "Menyimpan id diary baru ke variable created_id untuk dipakai request PUT/DELETE berikutnya.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Belajar REST API\",\n  \"diary_date\": \"2026-11-23\",\n  \"body\": \"Hari ini saya belajar menghubungkan Express dan MySQL.\",\n  \"mood\": \"😊\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set(\"created_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
